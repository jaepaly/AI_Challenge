# ── KIS Developers (한국투자 오픈API) ─────────────────────────────
# 모의투자 도메인: https://openapivts.koreainvestment.com:29443
# 실전    도메인: https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=            # 모의투자 계좌번호 (8-2 형식)
KIS_ENV=vps                # vps=모의 | prod=실전. prod 전환은 반드시 TR_ID 가드 경유
KIS_PROXY_TOKEN=           # Required for /api/kis/balance and /api/kis/buyable. Send as x-marginguard-kis-proxy-token.

# ── Anthropic (약관 인제스트) ─────────────────────────────────────
# 프롬프트 개발 단계에는 불필요하다 — Claude Code CLI 헤드리스(구독)로 한다.
#   claude -p "..." --output-format json --json-schema '...'
#   ※ --bare 를 붙이면 OAuth를 읽지 않아 구독으로 동작하지 않는다(API 키 필수)
#   ※ CLI로는 base64 PDF document 블록을 만들 수 없다 — citations 근거 좌표(§5-B-2 ⓒ)는
#     API 경로에서만 나온다. 0원 경로로 검증할 수 있는 것은 표 재현율까지다.
#
# 키는 **사람별·용도별로 분리**한다. 하나가 새면 그것만 폐기하면 되고,
# 폐기 범위가 다른 사람에게 번지지 않는다.
#
#   ingest-dev  팀장  이 파일(로컬 .env). 사전 계산 배치 · 토큰 측정
#   ingest-b    B     B의 로컬 .env. 8/17 실측 · 프롬프트 반복
#   web-prod    C     **Vercel 환경변수에만.** 어떤 파일에도 넣지 않는다
#
# ⚠ **키를 전달하지 않는다 — 콘솔에 초대해 각자 발급하게 한다.**
#   전달하는 순간 사본이 늘고, 카톡·이메일·스크린샷에 영구 보관되고,
#   누가 어느 키를 쓰는지 추적이 끊긴다. 초대가 불가할 때만 비밀 공유 도구를
#   쓰고, 받은 직후 그 키를 폐기하고 재발급한다.
#   (실제로 이렇게 했다 — 팀장이 만든 web-prod은 C가 자기 키를 발급한 뒤 폐기했다.)
#
# ⚠ 키를 **명령줄에 붙여넣지 않는다** — PowerShell 히스토리
#   (ConsoleHost_history.txt)에 평문으로 남는다. .env를 편집기로 열어 넣을 것.
#
# ⚠ 배포 백엔드는 반드시 API 키를 쓴다 — 구독으로 심사위원 트래픽을 처리하는 것은
#   금지 대상이다(§5-B-1 인용 참조).
#
# 💡 비용 통제의 1순위는 spend limit이 아니라 **캐시**다. 문서 블록에
#   cache_control을 걸고 5분 안에 반복하면 튜닝 50회가 12,259원 → 1,508원이다
#   (§5-B-1 실측값). 선불 잔액이 실질 하드캡이므로 **자동 충전은 끈다.**
ANTHROPIC_API_KEY=
ANTHROPIC_INGEST_MODEL=claude-sonnet-5  # 비우면 서비스 기본값 claude-sonnet-5

# ── 주의 ─────────────────────────────────────────────────────────
# 이 파일을 .env로 복사해서 채울 것. .env는 .gitignore로 차단돼 있다.
# 키가 커밋되면 즉시 재발급 + 히스토리 정리 (팀장에게 보고).
