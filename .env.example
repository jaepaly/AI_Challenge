# ── KIS Developers (한국투자 오픈API) ─────────────────────────────
# 모의투자 도메인: https://openapivts.koreainvestment.com:29443
# 실전    도메인: https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=            # 모의투자 계좌번호 (8-2 형식)
KIS_ENV=vps                # vps=모의 | prod=실전. prod 전환은 반드시 TR_ID 가드 경유

# ── Anthropic (약관 인제스트 — B 전용) ────────────────────────────
ANTHROPIC_API_KEY=

# ── 주의 ─────────────────────────────────────────────────────────
# 이 파일을 .env로 복사해서 채울 것. .env는 .gitignore로 차단돼 있다.
# 키가 커밋되면 즉시 재발급 + 히스토리 정리 (팀장에게 보고).
