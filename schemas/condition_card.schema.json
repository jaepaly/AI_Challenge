{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "marginguard/condition_card/v2",
  "title": "ConditionCard v2",
  "description": "약관 인제스트(B)의 출력 계약이자 LLM 출력 검증기. TS 미러: packages/engine/src/types.ts, Pydantic 미러: services/ingest/app/schemas.py. 변경은 PR + 전원 승인.",
  "type": "object",
  "additionalProperties": false,
  "required": ["broker", "ratio_rules", "account_aggregation", "disposal_price_rules", "execution_schedule", "ratio_source", "doc_version", "status"],
  "properties": {
    "broker": { "type": "string", "minLength": 1 },
    "ratio_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_type", "collateral_type", "symbol_group", "ratio", "evidence"],
        "properties": {
          "product_type": { "type": "string" },
          "collateral_type": { "type": "string" },
          "symbol_group": { "type": "string" },
          "ratio": { "type": "number", "minimum": 1.0, "maximum": 2.0, "description": "담보유지비율. 실측 편차 105~170% — 범위 밖이면 추출 오류로 간주하고 거부" },
          "evidence": { "$ref": "#/definitions/evidence_span" }
        }
      }
    },
    "account_aggregation": { "enum": ["max", "weighted_average"] },
    "disposal_price_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "symbol_group", "discount_basis", "source_confidence", "evidence"],
        "properties": {
          "trigger": { "type": "string" },
          "symbol_group": { "type": "string" },
          "discount_basis": { "enum": ["prev_close_pct", "lower_limit"] },
          "discount_rate": { "type": "number", "minimum": 0, "maximum": 0.35, "description": "h. prev_close_pct일 때 필수적으로 채울 것" },
          "source_confidence": { "enum": ["explicit", "inferred_from_formula"] },
          "evidence": { "$ref": "#/definitions/evidence_span" }
        }
      }
    },
    "execution_schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threshold_ratio", "day_counting", "evidence"],
        "properties": {
          "threshold_ratio": { "type": "number", "minimum": 1.0, "maximum": 2.0 },
          "day_counting": { "type": "string" },
          "evidence": { "$ref": "#/definitions/evidence_span" }
        }
      }
    },
    "ratio_source": { "enum": ["clause", "website_notice", "hts_only"] },
    "doc_version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_no": { "type": "string", "description": "심사필 번호 (우선)" },
        "content_sha256": { "type": "string", "description": "번호 없는 회사의 폴백" },
        "revised_at": { "type": "string" }
      },
      "anyOf": [{ "required": ["review_no"] }, { "required": ["content_sha256"] }]
    },
    "contract_vintage": { "type": "string" },
    "status": { "enum": ["verified", "draft"], "description": "인제스트 직후는 반드시 draft. verified 승격은 사람 검수 후" },
    "verified_at": { "type": "string", "format": "date", "description": "신선도 게이트(30일)의 기준일 — 수집일이 아니라 검증일" }
  },
  "definitions": {
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "start", "end", "quote"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string", "minLength": 1, "description": "원문 인용. 좌표를 못 찾으면 카드 전체를 거부한다 — 근거 없는 수치 금지" }
      }
    }
  }
}
